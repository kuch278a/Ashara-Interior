# Firebase Functions Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Gmail credentials - Use App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail-address@example.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Admin email to receive notifications
ADMIN_EMAIL=your-admin-address@example.com

# Studio contact details shown in client confirmation emails
STUDIO_ADDRESS=Megenagna, Infront of Ethio Ceramics, Bete Sahlite-Mihret Building, 4th Floor, Addis Ababa, Ethiopia
STUDIO_PHONE=+251912195768
STUDIO_PHONE_DISPLAY=+251 91 219 5768
STUDIO_EMAIL=your-studio-address@example.com

# Link to the admin portal included in notification emails
ADMIN_PORTAL_URL=https://ashara-interiors.web.app/admin
