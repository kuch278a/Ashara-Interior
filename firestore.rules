rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are non-anonymous, signed-in users whose email is on the
    // allowlist below. Anonymous sign-ins (used by the public site for
    // reading) are explicitly rejected for every write path.
    // UPDATE the email below to the admin account you created in
    // Firebase Console > Authentication > Users.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email in ['admin@ashara.com'];
    }

    // ──────────────────────────────────────────────
    // PROJECTS — public can read, only admins can write
    // ──────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // BLOG POSTS — public can read, only admins can write
    // ──────────────────────────────────────────────
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // TESTIMONIALS — public can read (project detail pages),
    // only admins can write
    // ──────────────────────────────────────────────
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // DELETED DEFAULT MARKERS — tombstones that keep deleted
    // default projects/testimonials from resurrecting.
    // Any signed-in client (the site signs in anonymously) can read;
    // only admins can write.
    // ──────────────────────────────────────────────
    match /deleted_defaults/{markerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // CONSULTATIONS
    //
    // Public (unauthenticated) may CREATE, because the contact form
    // is anonymous — but the create is strictly validated:
    //   * only the six expected fields may be written (no extra keys)
    //   * status must be 'new' (a visitor cannot self-mark a lead
    //     as 'contacted'/'completed')
    //   * email must look like an email, and all fields are length
    //     capped, so the notification function cannot be abused as an
    //     open mail relay with huge payloads
    //
    // READ/UPDATE/DELETE are admin-only: the leads contain real names,
    // emails and phone numbers and must never be exposed to
    // anonymous or public users.
    // ──────────────────────────────────────────────
    match /consultations/{leadId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'fullName', 'email', 'telephone', 'enquiry', 'createdAt', 'status'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.telephone is string
        && request.resource.data.telephone.size() <= 40
        && request.resource.data.enquiry is string
        && request.resource.data.enquiry.size() > 0
        && request.resource.data.enquiry.size() <= 5000
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() > 0
        && request.resource.data.createdAt.size() <= 64
        && request.resource.data.status == 'new';

      allow read, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // DEFAULT — Deny everything else
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
