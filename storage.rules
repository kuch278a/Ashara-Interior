rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Only non-anonymous admin accounts on the allowlist may upload.
    // UPDATE the email below to the admin account you created in
    // Firebase Console > Authentication > Users.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email in ['admin@ashara.com'];
    }

    // Images folder — admins can upload, anyone can read
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024  // Max 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Default — deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
