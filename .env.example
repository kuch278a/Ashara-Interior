# ----------------------------------------------------
# Ashara Interiors - Firebase Cloud Environment Configuration
# ----------------------------------------------------
# 1. Go to https://console.firebase.google.com/
# 2. Create a project -> Project Settings -> General -> Your Apps -> Web App (</>)
# 3. Copy your configuration values and paste them below:

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ----------------------------------------------------
# Enquiry email notifications (EmailJS)
# ----------------------------------------------------
# EmailJS sends emails directly from the browser using your connected
# Gmail or Outlook account — no backend or Cloud Functions needed.
#
# Setup steps:
#   1. Sign up free at https://www.emailjs.com/
#   2. Go to Email Services -> Add New Service -> connect Gmail or Outlook
#      Copy the Service ID shown (e.g. "service_xxxxxxx")
#   3. Go to Email Templates -> Create New Template
#      Use these variable names in your template body:
#        {{client_name}}   — the enquirer's full name
#        {{client_email}}  — the enquirer's email address
#        {{client_phone}}  — the enquirer's phone number
#        {{enquiry}}       — the enquiry message text
#        {{submitted_at}}  — date and time the form was submitted
#      Set Reply-To to: {{reply_to}}
#      Copy the Template ID (e.g. "template_xxxxxxx")
#   4. Go to Account -> General -> copy your Public Key
#
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

