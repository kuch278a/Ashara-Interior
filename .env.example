# ----------------------------------------------------
# Ashara Interiors - Firebase Cloud Environment Configuration
# ----------------------------------------------------
# 1. Go to https://console.firebase.google.com/
# 2. Create a project -> Project Settings -> General -> Your Apps -> Web App (</>)
# 3. Copy your configuration values and paste them below:

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ----------------------------------------------------
# Enquiry email notifications (Web3Forms)
# ----------------------------------------------------
# Cloud Functions need the Firebase Blaze (paid) plan, so enquiry
# notifications are relayed through Web3Forms instead. The access key
# ships in the client bundle by design; it only lets the site send mail
# to the inbox it is paired with.
# 1. Sign up at https://web3forms.com
# 2. Dashboard -> Access Key -> copy it below
# 3. Enquiries are delivered to the email address you signed up with.

VITE_WEB3FORMS_KEY=your_web3forms_access_key_here
